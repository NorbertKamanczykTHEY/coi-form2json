# Copy to app/.env (git-ignored). Docker compose reads it via env_file; local runs read it from coi.config.
EDENAI_API_KEY=
# LLM provider: eden (default) | local (air gap: OpenAI-compatible vLLM/Ollama, no outbound traffic, no Eden key)
# LLM_PROVIDER=eden
# LLM_BASE_URL=           # empty = provider default (eden: https://api.edenai.run/v3, local: http://localhost:11434/v1)
# LLM_API_KEY=            # eden: overrides EDENAI_API_KEY; local: only if the server wants one
# MAX_FILE_MB=20
# LADDER_PATH=            # VLM ladder JSON; default coi/parsing/ladder.json (eden) or ladder.local.json (local)
# TESSDATA_PREFIX=        # folder with pol.traineddata, only if Tesseract's default has no Polish model (local dev)
# RENDER_FONT=            # TTF with Polish glyphs for the ODS/XLSX fallback render; default DejaVu Sans / Arial

# REST API (backend/coi/__init__.py). Demo token: docker compose exec backend python -m coi.make_token
# HS256 shared secret (32+ random bytes, e.g. openssl rand -hex 32); not needed with JWT_ALG=RS256 + JWT_JWKS_URL (IdP)
JWT_SECRET=
# POST /api/v1/forms and /forms/validate work without a token (stored as created_by=anonymous); a token that is sent must be valid.
# Production: false, then every endpoint needs a JWT (ADR 0015, addendum).
AUTH_PUBLIC_CONVERT=true
JWT_ALG=HS256
# JWT_JWKS_URL=
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_LEEWAY_S=30
# MAX_FILENAME_LEN=250
# Database (SQLAlchemy URL). Default: SQLite on the compose volume. Production e.g. postgresql+psycopg://user:pass@host/coi (driver must be installed).
# Local runs outside Docker: DATABASE_URL=sqlite:///./data/coi.sqlite. DB_PATH=<file> still works as a SQLite-only alias.
# DATABASE_URL=sqlite:////data/coi.sqlite
# LOG_LEVEL=INFO

# Dictionaries: label/options score needed to match a field to a dictionary (app/docs/dictionaries.md)
# DICT_MATCH_THRESHOLD=0.8

# Generator: "Twoje dane" identity source MLPZ|PESEL (Q24)
# GENERATOR_PREFILL_IDENTITY=MLPZ

# LLM: seconds one call may take; a timeout fails that rung of the ladder (VLM or extraction), which escalates
# LLM_TIMEOUT_S=90

# Field extraction (coi/config/extraction.py): model rungs tried in order, each with one repair round
# EXTRACTION_LADDER=mistral/mistral-small-2603,mistral/mistral-large-2512
# EXTRACTION_MAX_TOKENS=24000
# Two-stage extraction (skeleton, then pages in parallel) above this many blocks
# EXTRACTION_TWO_STAGE_BLOCKS=150
# EXTRACTION_WORKERS=4

# shortcut (demo only): run-them-all.sh writes a fresh 7-day JWT here on every start; the frontend serves it at /config.js
# and skips the token prompt. Informational for curl/Swagger. Production: IdP login instead (ADR 0015, addendum).
DEMO_API_TOKEN=
