  {
   "key": "pelnomocnictwo",
   "description_html": "<html><head></head><body><p><span style=\"background-color: rgb(255, 255, 255); color: rgb(31, 35, 40);\">Dodaj dokument potwierdzający, że jesteś pełnomocnikiem.</span></p></body></html>",
   "show_if": {
    "any": [
     {
      "field": "wybierz_w_czyim_imieniu_wnioskujesz",
      "in": [
       "Innej osoby"
      ]
     },
     {
      "all": [
       {
        "field": "wybierz_w_czyim_imieniu_wnioskujesz",
        "in": [
         "{{entity_option}}"
        ]
       },
       {
        "field": "wybierz_jako_kto_wnioskujesz",
        "in": [
         "Pełnomocnik"
