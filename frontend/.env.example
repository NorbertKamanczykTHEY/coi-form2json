# Demo JWT sent as Authorization: Bearer. It is baked into the JS bundle, so demo only.
# Generate (signed with JWT_SECRET from app/.env): cd ../backend && uv run python -m coi.make_token demo-frontend --hours 720
VITE_API_TOKEN=
# Max parallel uploads when several files are selected (each file = one request). Default 3.
VITE_BATCH_CONCURRENCY=3
